# Optional backend settings. No credentials are required for local single-user mode.
# Relative paths are resolved from the SpendSense project root.
DATABASE_PATH=./backend/spendsense.db
# Leave blank to use the existing SQLite database. PostgreSQL URLs require TLS.
DATABASE_URL=
MAX_UPLOAD_BYTES=10485760
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Optional Groq provider. Keep credentials in this backend-only file.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Backward-compatible optional OpenAI-compatible provider.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
